  "romanian-deadlift": {
    "start": "hinge_top",
    "end": "rdl_bottom",
    "cap_start": "起始（站立）",
    "cap_end": "底部",
    "note": "罗马尼亚硬拉膝角基本不变，位移来自髋——这是它与常规硬拉的分界。底部躯干约 34°、杠到膝高；但转到侧面时杠仍离大腿约 20px：底部的膝在踝之后、足中线又在踝之前，杠落在足中线的铅垂线上就贴不到腿。实际动作应当贴腿下行。"
  },
  "db-romanian-deadlift": {
    "start": "hinge_top",
    "end": "rdl_bottom",
    "cap_start": "起始",
    "cap_end": "底部",
    "load_type": "hands",
    "note": "底部哑铃到膝高，但转到侧面时离大腿约 20px——为守住「负荷过足中线」，铅垂线与大腿之间有结构性缝隙。实际动作哑铃应贴着腿下行，自检时看的就是这条缝。"
  },
